{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PulseCrawl analysis manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "analysisId", "createdAt", "includedExecutions", "method", "outputs"],
  "properties": {
    "schemaVersion": {"const": 1},
    "analysisId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "createdAt": {"type": "string", "format": "date-time"},
    "includedExecutions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "excludedExecutions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["executionId", "reason"],
        "properties": {"executionId": {"type": "string"}, "reason": {"type": "string"}}
      }
    },
    "method": {"type": "string"},
    "software": {"type": "object", "additionalProperties": {"type": "string"}},
    "outputs": {"type": "object", "additionalProperties": {"type": "string"}}
  }
}
